# ─────────────────────────────────────────────────────────────
#  TELRO — configuration
#  Copy this file to .env and fill in the values you need.
#  Every key below maps to a Settings field in bot/config.py.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:AA...replace-me

# Public username of the bot (without @) — used for invite links
BOT_USERNAME=Rwinro_bot
# Optional display name; normally auto-detected from Telegram at startup
# BOT_NAME=TELRO

# Telegram numeric user IDs that can open /admin (comma separated).
# Send /id to the bot to discover your own ID.
OWNER_IDS=
ADMIN_IDS=

# ── Storage ──────────────────────────────────────────────────
# DATA_DIR=data
DB_PATH=data/telro.db
DOWNLOAD_DIR=data/downloads
# GENERATED_DIR=data/generated
# LOG_FILE=data/telro.log
COOKIES_FILE=
# Optional HTTP/SOCKS proxy, e.g. socks5://127.0.0.1:1080
PROXY=

# ── Downloads ────────────────────────────────────────────────
# 0 = auto (50 MB with the cloud API, 2 GB with a local Bot API server)
MAX_UPLOAD_MB=0
MAX_CONCURRENT_DOWNLOADS=2
YTDLP_FRAGMENTS=8
DOWNLOAD_TIMEOUT=900
# Per-link metadata inspection timeout (seconds)
# EXTRACT_TIMEOUT=45
AUTO_COMPRESS=true
SEND_AS_DOCUMENT=false

# Optional local Bot API server (removes the 50 MB limit).
# Both TELEGRAM_API_SERVER and the short alias API_SERVER are accepted.
# TELEGRAM_API_SERVER=http://127.0.0.1:8081

# ── Quotas / referral ────────────────────────────────────────
FREE_DOWNLOADS_PER_DAY=25
FREE_AI_PER_DAY=60
REFERRAL_TARGET=5
REFERRAL_REWARD_DAYS=7

# ── AI (OpenAI-compatible) ───────────────────────────────────
# Free default (may be rate-limited):
AI_BASE_URL=https://text.pollinations.ai/openai
AI_API_KEY=
AI_MODEL=openai
# Examples for other providers:
# AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=google/gemini-2.5-flash
# AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=http://127.0.0.1:11434/v1        AI_MODEL=qwen2.5:7b
# Optional custom system prompt (empty = built-in Persian/English default)
# AI_SYSTEM_PROMPT=
AI_MAX_TOKENS=1200
AI_TIMEOUT=120
AI_HISTORY_MESSAGES=18
# Max characters of conversation history sent with each request
# AI_HISTORY_CHARS=12000
AI_VISION=true
AI_STREAM=true
# Voice transcription needs an OpenAI-compatible Whisper endpoint
AI_TRANSCRIBE=false

# ── Image generation ─────────────────────────────────────────
# pollinations (free, no key) | openai (needs key) | disabled
IMAGE_PROVIDER=pollinations
# IMAGE_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_MODEL=flux
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_API_KEY=
# IMAGE_TIMEOUT=150

# ── Access / UX ──────────────────────────────────────────────
# Comma separated: @channel or -1001234567890 or https://t.me/+invite
FORCE_JOIN_CHANNELS=
SUPPORT_USERNAME=
CHANNEL_USERNAME=
ENABLE_GROUPS=false
THROTTLE_MESSAGES=8
THROTTLE_CALLBACKS=15
THROTTLE_WINDOW=10

# ── Misc ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
# IANA timezone name for dates shown to users, e.g. Asia/Tehran
# TIMEZONE=UTC
# Grace period (seconds) for in-flight downloads during shutdown
# SHUTDOWN_TIMEOUT=10
